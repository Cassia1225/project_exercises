# .env.hivemq にコピーし、全PCのMQTT設定をそろえる（既存.envは上書きしない）。
# HiveMQ公開Brokerは学習・検証専用。他者も購読・送信できる。
# 秘密情報・実アレルギー・精密な現在地などはPublishしない。架空条件で試す。
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=8884
MQTT_TRANSPORT=websockets
MQTT_WS_PATH=/mqtt
MQTT_TLS=true

# 全PCで同じ、班専用の十分長いランダムIDに置換する。
# 混線を減らすための名前であり、秘密保持・アクセス制御にはならない。
MQTT_TOPIC_PREFIX=group8/hivemq-test/replace-with-shared-random-id/v1

# 公開Brokerには認証不要。既存LAN用認証を引き継がないため空を明示する。
MQTT_USERNAME=
MQTT_PASSWORD=

# 最初はダミー花粉で試す。キーはPublishしない。
GOOGLE_POLLEN_API_KEY=
