# .env.emqxへコピーする。公開Brokerは架空条件のデモ・試験専用。
MQTT_BROKER=broker.emqx.io
MQTT_PORT=8084
MQTT_TRANSPORT=websockets
MQTT_WS_PATH=/mqtt
MQTT_TLS=true

# 代表者1人がランダム値を生成し、全PCへ同じ値を共有する。
# ランダム値は混線回避用であり、アクセス制御ではない。
MQTT_TOPIC_PREFIX=group8/emqx-test/replace-with-shared-random-id/v1

# 既存LAN設定や.envの認証値・APIキーを引き継がないよう空欄を明示する。
MQTT_USERNAME=
MQTT_PASSWORD=
GOOGLE_POLLEN_API_KEY=
