# このファイルを .env という名前でコピーして使う（.env はGitに含めない）

# Google Pollen APIのキー。空のままだと花粉はダミーの値になる
GOOGLE_POLLEN_API_KEY=

# MQTTブローカー。自分のPCのMosquittoなら localhost
# 別々のPCで動かすときは、Mosquittoを動かすPCのIPアドレス（例: 192.168.0.10）にする
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TRANSPORT=tcp
MQTT_WS_PATH=/mqtt
MQTT_TLS=false

# トピック名の先頭。公開ブローカーで他の班と混ざらないように変えてもよい
MQTT_TOPIC_PREFIX=project_exercises/v1
