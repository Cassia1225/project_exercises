# .env.lan にコピーする。従来の .env は1台用として残してよい。
# 全員が同じBroker、ポート、Topicの先頭、ユーザー名・パスワードを使う。

# Brokerを起動するPCのIPv4アドレス。下は例なので、実際のアドレスに書き換える。
MQTT_BROKER=192.168.0.10
# 既存のローカル用1883と分けるため、複数PC用は1884を使う。
MQTT_PORT=1884
MQTT_TRANSPORT=tcp
MQTT_WS_PATH=/mqtt
MQTT_TLS=false
MQTT_TOPIC_PREFIX=group8/project_exercises/v1

# Brokerで登録したユーザー名・パスワード。秘密の値はGitに保存しない。
MQTT_USERNAME=group8
MQTT_PASSWORD=

# 花粉担当のPCだけが実際のキーを記入する。空なら花粉はダミーデータになる。
GOOGLE_POLLEN_API_KEY=
